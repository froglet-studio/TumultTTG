{
  "comment": "Load order for the single-file build and for Node tools. Every file attaches to the global namespace T; later files may use anything defined by earlier ones. The playtest files are added only to the playtest build (npm run build:playtest).",
  "engine": [
    "data/cards.js",
    "data/world.js",
    "data/story.js",
    "data/expeditions.js",
    "data/atlas.js",
    "data/canon.js",
    "engine/generators.js",
    "engine/engine.js",
    "engine/ai.js",
    "engine/lookahead.js",
    "engine/party.js",
    "engine/story.js",
    "engine/run.js",
    "engine/canon.js"
  ],
  "ui": ["ui/icons.js", "ui/core.js", "ui/party.js", "ui/pilots.js", "ui/mission.js", "ui/atlas.js", "ui/canon.js"],
  "css": ["ui/style.css", "ui/theme.css", "ui/party.css", "ui/atlas.css", "ui/canon.css"],
  "playtest": {
    "js": ["ui/playtest.js", "ui/net.js"],
    "css": ["ui/playtest.css", "ui/net.css"]
  },
  "art": {
    "comment": "Inlined by tools/build.mjs as data URIs (assets/README.md says where each piece comes from and its licence).",
    "images": ["assets/pilots", "assets/scenes"],
    "fonts": [
      {
        "family": "Chakra Petch",
        "weight": 600,
        "file": "assets/fonts/ChakraPetch-SemiBold.woff2"
      }
    ]
  }
}
