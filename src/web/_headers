# Cloudflare Pages response headers for the web version (GitHub Pages ignores this file).
# Files under /assets/ are named by their content and never change; the page and the service
# worker must always be checked, so a new release reaches players on their next visit.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
