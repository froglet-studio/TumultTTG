{
  "name": "tumult-ttg",
  "version": "2.1.0",
  "description": "A character driven table top game about completing missions on Tumult",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/froglet-studio/TumultTTG.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node tools/build.mjs --check",
    "build:playtest": "node tools/build.mjs --playtest --check",
    "dev": "node tools/dev-server.mjs",
    "test": "node --test",
    "sim": "node tools/sim.js",
    "mission-log": "node tools/mission-log.js",
    "catalog": "node tools/catalog.js",
    "audit": "node tools/audit.js",
    "docs": "node tools/catalog.js && node tools/audit.js",
    "ui-test": "node tools/ui-drive.js",
    "format": "prettier --write \"src/**/*.{js,css,html,json}\" \"tools/**/*.{js,mjs}\" \"test/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.{js,css,html,json}\" \"tools/**/*.{js,mjs}\" \"test/**/*.js\"",
    "check": "npm run build && npm test"
  },
  "devDependencies": {
    "jsdom": "^24.1.3",
    "prettier": "^3.3.3"
  }
}
